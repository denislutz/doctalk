# =============================================================================
# DocTalk Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# API key for authentication (change this to a secure random string)
API_KEY=your-secure-api-key-here

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Default LLM provider: 'ollama' (local) or 'anthropic' (API)
DEFAULT_LLM_PROVIDER=ollama

# Default model for Ollama (must be pulled first)
DEFAULT_LLM_MODEL=llama3.2:3b

# Anthropic API key (optional - only needed if using Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude model to use (if using Anthropic provider)
ANTHROPIC_MODEL=claude-3-haiku-20240307

# -----------------------------------------------------------------------------
# Vector Database
# -----------------------------------------------------------------------------
# Qdrant connection
QDRANT_URL=http://localhost:6333

# Qdrant API key (optional, for authenticated Qdrant instances)
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Ollama Configuration
# -----------------------------------------------------------------------------
# Ollama service URL (local install)
OLLAMA_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Sentence-transformers model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, production, testing
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for uploaded documents
UPLOAD_DIR=uploads

# -----------------------------------------------------------------------------
# Chunking Configuration
# -----------------------------------------------------------------------------
# Maximum chunk size in tokens
MAX_CHUNK_SIZE=512

# Token overlap between chunks
CHUNK_OVERLAP=50

# Minimum chunk size (skip tiny fragments)
MIN_CHUNK_SIZE=50

# CSV rows per chunk
CSV_ROWS_PER_CHUNK=25

# -----------------------------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------------------------
# Number of candidates from dense search
DENSE_TOP_K=20

# Number of candidates from sparse search
SPARSE_TOP_K=20

# Final number of chunks after re-ranking
RERANK_TOP_K=5

# Enable cross-encoder re-ranking
USE_RERANKING=true

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Backend API URL (from frontend container perspective)
API_URL=http://localhost:8000
