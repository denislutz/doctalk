# =============================================================================
# Test environment overrides
# Loaded automatically by pytest via pytest-env (see pyproject.toml).
# Never committed with real secrets — keep this file in version control.
#
# Infrastructure:
#   Qdrant  — Docker (docker-compose.test.yml, port 6335), isolated from dev
#   SQLite  — :memory: per test, no file, no cleanup needed
#   Ollama  — local install on localhost:11434, same as dev
# =============================================================================

ENVIRONMENT=testing
LOG_LEVEL=WARNING

# Isolated test Qdrant (docker-compose.test.yml)
VECTOR_DB_URL=http://localhost:6335

# In-memory SQLite — destroyed automatically after each test
REGISTRY_DB_PATH=:memory:

# Local Ollama — same instance as dev, no Docker needed
LANGCHAIN_LLM_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2:3b

API_KEY=test-key
